{
  "name": "GeneratedDocument",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "document_key": {
      "type": "string"
    },
    "document_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "needs_review",
        "missing_profile_data",
        "office_only",
        "error"
      ],
      "default": "needs_review"
    },
    "fill_method": {
      "type": "string",
      "enum": [
        "acroform",
        "coordinates",
        "support-sheet"
      ]
    },
    "official_submittable": {
      "type": "boolean",
      "default": false
    },
    "source_type": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_label": {
      "type": "string"
    },
    "runtime_template_url": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "profile_snapshot_version": {
      "type": "number"
    },
    "missing_profile_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "missing_assets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "instruction_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "requires_notary": {
      "type": "boolean",
      "default": false
    },
    "requires_physical_presence": {
      "type": "boolean",
      "default": false
    },
    "pdf_file_url": {
      "type": "string"
    },
    "download_file_name": {
      "type": "string"
    },
    "mime_type": {
      "type": "string",
      "default": "application/pdf"
    },
    "drive_upload_status": {
      "type": "string",
      "enum": [
        "not_uploaded",
        "uploading",
        "uploaded",
        "error"
      ],
      "default": "not_uploaded"
    },
    "google_drive_file_id": {
      "type": "string"
    },
    "google_drive_web_view_link": {
      "type": "string"
    },
    "procedure_key": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "document_key",
    "document_title"
  ]
}